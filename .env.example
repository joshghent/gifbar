# Base URL of the GIF proxy Worker (see worker/). Optional: the app falls back
# to the deployed default. Point it at http://localhost:8787 to develop against
# a local `wrangler dev`.
VITE_GIF_API_BASE=

# The GIPHY and Tenor keys are NOT set here any more — they live as Cloudflare
# Worker secrets so they never get bundled into a shipped binary:
#   cd worker && npx wrangler secret put GIPHY_API_KEY
#   cd worker && npx wrangler secret put TENOR_API_KEY
